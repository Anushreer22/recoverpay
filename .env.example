ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

ORCHESTRATOR_SEED=change-me-to-a-long-random-phrase
VERIFIER_SEED=change-me-to-verifier-seed
FALLBACK_SEED=change-me-to-fallback-seed
DRAFTER_SEED=change-me-to-drafter-seed

# Backwards-compatible aliases
RECONCILER_SEED=change-me-to-verifier-seed
RECONCILER_LITE_SEED=change-me-to-fallback-seed

ORCHESTRATOR_PORT=8000
VERIFIER_PORT=8001
FALLBACK_PORT=8002
DRAFTER_PORT=8003

RECONCILER_PORT=8001
RECONCILER_LITE_PORT=8002

# Optional: paste agent1q... addresses after first run to enable agent-to-agent dispatch
VERIFIER_ADDRESS=
FALLBACK_ADDRESS=
DRAFTER_ADDRESS=

RECONCILER_ADDRESS=
RECONCILER_LITE_ADDRESS=
